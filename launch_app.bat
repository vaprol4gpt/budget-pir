@echo off
REM launch_app.bat -- запуск интерфейса ПИР двойным кликом, без консольных
REM команд от пользователя. Что делает каждая строка -- ниже.

REM 1) %~dp0 -- папка, где лежит сам этот .bat-файл (с завершающим "\").
REM    Переходим в неё явно, чтобы скрипт работал одинаково независимо
REM    от того, откуда Windows его запустила (двойной клик из Проводника
REM    даёт в качестве текущей папки именно её, но лучше не полагаться
REM    на это неявно).
cd /d "%~dp0"

REM 2) Активируем venv для ЭТОЙ консоли. На Windows активация -- это
REM    отдельный .bat-скрипт (venv\Scripts\activate.bat), а не команда
REM    "source" как в bash/Linux. Используем "call", а не просто запуск
REM    по имени: без call управление "проваливается" внутрь activate.bat
REM    и на этом выполнение launch_app.bat обрывается, ни одна строка
REM    после активации не выполнится.
REM    Папка окружения: .venv (создаёт setup.bat) или, если её нет,
REM    прежняя venv.
set "VENV_DIR=%~dp0.venv"
if not exist "%VENV_DIR%\Scripts\activate.bat" set "VENV_DIR=%~dp0venv"
call "%VENV_DIR%\Scripts\activate.bat"

REM 3) Проверка: venv правда активировался (python.exe взялся из venv,
REM    а не из системного PATH). Если нет -- сообщаем и не пытаемся
REM    запускать streamlit несуществующим/чужим python.
REM    findstr даже с /L считает "\" escape-символом ("\.venv" -> ".venv"),
REM    поэтому в шаблоне обратные слэши удваиваются.
set "VENV_PAT=%VENV_DIR:\=\\%"
where python | findstr /I /L /C:"%VENV_PAT%" >nul
if errorlevel 1 (
    echo [Ошибка] Не удалось активировать окружение в %VENV_DIR%
    echo Запустите setup.bat -- он создаст .venv рядом с launch_app.bat.
    pause
    exit /b 1
)

REM 3.5) Справочник расценок (data\references.sqlite) — сгенерированный
REM      файл, в git не хранится (см. .gitignore). При КАЖДОМ запуске —
REM      проверка: нет файла, повреждён, старая версия формата или эталоны/
REM      сборщик изменились после git pull — пересборка (С2, 30.10.2026).
REM      Актуален — ничего не делает. Программа проверяет то же сама при старте.
python "%~dp0data\build_references.py" --if-stale

REM 4) Запускаем сам интерфейс. Streamlit поднимает локальный веб-сервер
REM    на http://localhost:8501 и по умолчанию САМ открывает браузер
REM    (проверено: server.headless=False из коробки в этом окружении) --
REM    отдельная команда "открыть браузер" не нужна и только рискует
REM    открыть вторую вкладку раньше, чем сервер готов.
REM 5) Эта команда не завершается, пока сервер работает -- поэтому окно
REM    консоли остаётся открытым, это нормально и ожидаемо.
REM    ЗАКРЫТИЕ ЭТОГО ОКНА ОСТАНАВЛИВАЕТ ПРОГРАММУ.
REM    "python -m streamlit" (а не просто "streamlit"): так текущая папка --
REM    корень проекта -- попадает в sys.path и пакеты core/ и modules/
REM    импортируются без правки sys.path в самом скрипте интерфейса.
python -m streamlit run app\streamlit_app.py

REM 6) Если streamlit всё же завершился (например, с ошибкой при
REM    старте) -- не закрываем окно сразу, чтобы можно было прочитать,
REM    что написано в консоли.
pause
